# Keep the build context lean — data/ alone is ~770MB of runtime artifacts.
.git
.gitignore
data/
docs/
htmlcov/
.pytest_cache/
.ruff_cache/
__pycache__/
**/__pycache__/
*.pyc
.dockerignore
Dockerfile
docker-compose.yml
*.db
*.pcap
*.pcapng
prototype-friendly-ui/node_modules/
prototype-friendly-ui/dist/
prototype-friendly-ui/qa/
prototype-friendly-ui/reference/
prototype-friendly-ui/tests/
prototype-friendly-ui/worker/
prototype-friendly-ui/scripts/
